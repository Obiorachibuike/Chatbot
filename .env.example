# Copy to .env and fill in. Works with any OpenAI-compatible API.
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Other providers (examples):
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1        AI_MODEL=llama-3.3-70b-versatile
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1          AI_MODEL=google/gemini-2.0-flash-001
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
# Ollama:     AI_BASE_URL=http://localhost:11434/v1             AI_MODEL=llama3.2   AI_API_KEY=ollama
# PORT=8000
